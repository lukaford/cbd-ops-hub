# Leave unset to use the built-in local database (stored in .data/).
# Set to a Postgres connection string (Supabase, Neon) in production.
DATABASE_URL=

# JobTread grant key (read-only use). Leave unset to run on Manager pastes only.
JOBTREAD_GRANT_KEY=

# Shared sign-in password, used only until the first staff account is made at /setup.
APP_PASSWORD=

# Optional email (Resend) for staff invites and client sign-in links. Without it,
# staff copy the links and send them themselves.
RESEND_API_KEY=
EMAIL_FROM=
# The app's web address, for links in alert emails (e.g. https://hub.example.com).
APP_URL=
