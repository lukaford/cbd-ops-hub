# Leave unset to use the built-in local database (stored in .data/).
# Set to a Postgres connection string (Supabase, Neon) in production.
DATABASE_URL=

# JobTread grant key (read-only use). Leave unset to run on Manager pastes only.
JOBTREAD_GRANT_KEY=

# Shared sign-in password. Set it on any hosted copy; leave unset on your own computer.
APP_PASSWORD=
